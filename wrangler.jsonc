{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profile",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/*/"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAGE_VIEW_COUNTER",
        "class_name": "PageViewCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PageViewCounter"]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false
}
