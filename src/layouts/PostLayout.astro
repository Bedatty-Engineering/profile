---
import BaseLayout from "./BaseLayout.astro";
import { formatDate, getLocaleContent, localizePath, type Locale } from "../lib/i18n";
import { site } from "../lib/site";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  locale: Locale;
  switchPath: string;
  date?: Date;
  tags?: string[];
  projectDetail?: boolean;
  headings?: Heading[];
}

const { title, description, locale, switchPath, date, tags = [], projectDetail = false, headings = [] } = Astro.props;
const copy = getLocaleContent(locale);
const contentHeadings = headings.filter((heading) => heading.depth === 2);
const technologySymbols: Record<string, string> = {
  Go: "Go",
  k6: "k6",
  LitmusChaos: "✳",
  "Argo Workflows": "⌁",
  GitOps: "⌘",
  Python: "Py",
  "AI Agents": "✦",
  "Chaos Engineering": "ϟ",
  "Hexagonal Architecture": "⬡",
  "Release Validation": "✓",
  "GitHub Actions": "⚙",
  Terraform: "Tf",
  Cloudflare: "☁",
  JavaScript: "JS",
  Bash: "$_",
  "AWS CLI": "aws",
  "GitHub CLI": "gh",
  Docker: "🐳",
  "Platform Engineering": "⬡",
  "Open Source": "⑂",
  "Personal Projects": "✦",
  Homelab: "⌂",
  "Open Learning": "↗",
  "Projetos Pessoais": "✦",
  "Aprendizado Aberto": "↗",
  "Código Aberto": "⑂",
};
---

<BaseLayout
  title={`${title} | ${site.name}`}
  description={description}
  locale={locale}
  type="article"
  switchPath={switchPath}
>
  {projectDetail ? (
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
      <header class="mx-auto mb-10 max-w-5xl">
        <a href={localizePath("/projects", locale)} class="inline-flex items-center gap-2 text-sm text-mist transition-colors hover:text-cloud">
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" class="h-4 w-4">
            <path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {copy.projects.backToProjects}
        </a>
        <p class="section-kicker mt-8">{copy.common.detailView}</p>
        <h1 class="mt-4 max-w-4xl text-3xl font-semibold leading-tight tracking-tight text-white sm:text-5xl">
          {title}
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-7 text-mist sm:text-lg sm:leading-8">{description}</p>
      </header>

      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-14">
        <aside class="h-fit lg:sticky lg:top-28">
          {contentHeadings.length > 0 && (
            <nav aria-label={copy.projects.contentsLabel} class="border-l border-white/10 pl-4">
              <h2 class="text-sm font-semibold text-white">{copy.projects.contentsLabel}</h2>
              <ul class="mt-4 space-y-3">
                {contentHeadings.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`} data-toc-link class="text-sm leading-6 text-mist transition-colors hover:text-cloud">
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </aside>

        <div class="min-w-0">
          <article
            class="prose-cloud prose-project min-w-0"
            data-copy-default={copy.common.copy}
            data-copy-success={copy.common.copied}
            data-copy-error={copy.common.copyFailed}
            data-copy-label={copy.common.copyCode}
            data-copy-status-success={copy.common.codeCopied}
            data-copy-status-error={copy.common.codeCopyFailed}
          >
            <slot />
          </article>

          {tags.length > 0 && (
            <section aria-labelledby="project-technologies" class="mt-14 border-t border-white/10 pt-7">
              <h2 id="project-technologies" class="text-sm font-semibold text-white">{copy.projects.technologyTagsLabel}</h2>
              <ul class="mt-4 flex flex-wrap gap-2" aria-label={copy.projects.technologyTagsLabel}>
                {tags.map((tag) => (
                  <li class="technology-chip">
                    <span class="technology-symbol" aria-hidden="true">{technologySymbols[tag] ?? "•"}</span>
                    {tag}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>
    </section>
  ) : (
    <section class="mx-auto max-w-4xl px-6 py-20 lg:px-8 lg:py-24">
      <div class="shell p-8 sm:p-10">
        <p class="section-kicker">{copy.common.detailView}</p>
        <div class="mb-8 mt-6 flex flex-wrap items-center gap-4 text-sm text-mist">
          {date && <span>{formatDate(date, locale)}</span>}
          {
            tags.map((tag) => (
              <span class="rounded-md border border-cloud/20 bg-cloud/10 px-3 py-1 font-mono text-xs uppercase tracking-[0.2em] text-steel">
                {tag}
              </span>
            ))
          }
        </div>
        <h1 class="theme-text-gradient max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">
          {title}
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-mist">{description}</p>
        <article class="prose-cloud mt-10">
          <slot />
        </article>
      </div>
    </section>
  )}
</BaseLayout>

{projectDetail && (
  <script>
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
    const headingTargets = tocLinks
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((heading): heading is HTMLElement => heading instanceof HTMLElement);

    const setActiveHeading = (heading: HTMLElement) => {
      for (const link of tocLinks) {
        const active = link.hash === `#${heading.id}`;
        link.classList.toggle("is-active", active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };

    const isAtPageEnd = () =>
      Math.ceil(window.scrollY + window.innerHeight) >= document.documentElement.scrollHeight - 2;

    if (headingTargets.length > 0) {
      const updateActiveHeading = () => {
        const activationLine = window.innerHeight * 0.22;
        const activeHeading = isAtPageEnd()
          ? headingTargets[headingTargets.length - 1]
          : [...headingTargets]
              .reverse()
              .find((heading) => heading.getBoundingClientRect().top <= activationLine) ?? headingTargets[0];

        setActiveHeading(activeHeading);
      };

      window.addEventListener("scroll", updateActiveHeading, { passive: true });
      window.addEventListener("resize", updateActiveHeading);
      updateActiveHeading();
    }

    const projectArticle = document.querySelector<HTMLElement>(".prose-project");
    const codeBlocks = [...document.querySelectorAll<HTMLPreElement>(
      '.prose-project pre:not([data-language="mermaid"])'
    )];

    if (projectArticle && codeBlocks.length > 0) {
      const labels = {
        copy: projectArticle.dataset.copyDefault ?? "Copy",
        copied: projectArticle.dataset.copySuccess ?? "Copied",
        failed: projectArticle.dataset.copyError ?? "Failed",
        copyCode: projectArticle.dataset.copyLabel ?? "Copy code",
        copiedMessage: projectArticle.dataset.copyStatusSuccess ?? "Code copied to clipboard.",
        failedMessage: projectArticle.dataset.copyStatusError ?? "Unable to copy code automatically."
      };

      for (const [index, pre] of codeBlocks.entries()) {
        const wrapper = document.createElement("div");
        wrapper.className = "project-code-block";
        wrapper.dataset.codeBlock = String(index + 1);

        const toolbar = document.createElement("div");
        toolbar.className = "project-code-toolbar";

        const language = document.createElement("span");
        language.className = "project-code-language";
        language.textContent = pre.dataset.language || "code";

        const button = document.createElement("button");
        button.type = "button";
        button.className = "project-code-copy";
        button.setAttribute("aria-label", labels.copyCode);

        const icon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        icon.setAttribute("viewBox", "0 0 20 20");
        icon.setAttribute("fill", "none");
        icon.setAttribute("aria-hidden", "true");
        icon.classList.add("h-4", "w-4");
        const iconPath = document.createElementNS("http://www.w3.org/2000/svg", "path");
        iconPath.setAttribute("d", "M7 6.5V4.75A1.75 1.75 0 0 1 8.75 3h6.5A1.75 1.75 0 0 1 17 4.75v8.5A1.75 1.75 0 0 1 15.25 15H13.5M4.75 6H11A1.75 1.75 0 0 1 12.75 7.75v8.5A1.75 1.75 0 0 1 11 18H4.75A1.75 1.75 0 0 1 3 16.25v-8.5A1.75 1.75 0 0 1 4.75 6Z");
        iconPath.setAttribute("stroke", "currentColor");
        iconPath.setAttribute("stroke-width", "1.5");
        iconPath.setAttribute("stroke-linecap", "round");
        iconPath.setAttribute("stroke-linejoin", "round");
        icon.append(iconPath);

        const buttonLabel = document.createElement("span");
        buttonLabel.textContent = labels.copy;
        button.append(icon, buttonLabel);

        const status = document.createElement("span");
        status.className = "sr-only";
        status.setAttribute("aria-live", "polite");
        status.setAttribute("aria-atomic", "true");

        toolbar.append(language, button);
        pre.before(wrapper);
        wrapper.append(toolbar, pre, status);

        let resetTimer = 0;
        button.addEventListener("click", async () => {
          const source = pre.querySelector("code")?.textContent ?? pre.textContent ?? "";

          try {
            await navigator.clipboard.writeText(source);
            buttonLabel.textContent = labels.copied;
            button.setAttribute("aria-label", labels.copied);
            status.textContent = labels.copiedMessage;
          } catch {
            buttonLabel.textContent = labels.failed;
            button.setAttribute("aria-label", labels.copyCode);
            status.textContent = labels.failedMessage;
          }

          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            buttonLabel.textContent = labels.copy;
            button.setAttribute("aria-label", labels.copyCode);
          }, 1800);
        });
      }
    }
  </script>
)}
