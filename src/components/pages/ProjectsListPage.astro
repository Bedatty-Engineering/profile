---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../SectionIntro.astro";
import { getLocaleContent, getOtherLocale, localizePath, type Locale } from "../../lib/i18n";
import { site } from "../../lib/site";

interface Props {
  locale: Locale;
  projects: CollectionEntry<"projects">[];
}

const { locale, projects } = Astro.props;
const copy = getLocaleContent(locale);
const switchPath = localizePath("/projects", getOtherLocale(locale));
---

<BaseLayout title={`${copy.projects.title} | ${site.name}`} description={copy.projects.description} locale={locale} switchPath={switchPath}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <div class="reveal">
      <SectionIntro eyebrow={copy.projects.eyebrow} title={copy.projects.heading} copy={copy.projects.copy} />
    </div>

    {
      projects.length > 0 ? (
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {projects.map((project) => (
            <a
              href={localizePath(`/projects/${project.data.pathSlug}/`, locale)}
              class="shell group flex h-full flex-col p-6 transition-colors hover:border-cloud/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cloud sm:p-8"
            >
              <h2 class="text-xl font-semibold text-white transition-colors group-hover:text-cloud sm:text-2xl">
                {project.data.title}
              </h2>
              <p class="mt-4 text-sm leading-7 text-mist">{project.data.description}</p>
              <div class="mt-6 flex flex-wrap gap-2">
                {project.data.technologies.map((technology) => <span class="tag-chip">{technology}</span>)}
              </div>
              <span class="mt-7 text-sm font-semibold text-cloud">{copy.common.openProject}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="copy-muted mt-12 rounded-2xl border border-line bg-panel p-6">{copy.projects.empty}</p>
      )
    }
  </section>
</BaseLayout>
