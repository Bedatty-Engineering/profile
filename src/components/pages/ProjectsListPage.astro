---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../SectionIntro.astro";
import { getLocaleContent, getOtherLocale, localizePath, type Locale } from "../../lib/i18n";
import { site } from "../../lib/site";

interface Props {
  locale: Locale;
  projects: CollectionEntry<"projects">[];
}

const { locale, projects } = Astro.props;
const copy = getLocaleContent(locale);
const switchPath = localizePath("/projects", getOtherLocale(locale));
---

<BaseLayout title={`${copy.projects.title} | ${site.name}`} description={copy.projects.description} locale={locale} switchPath={switchPath}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <div class="reveal">
      <SectionIntro eyebrow={copy.projects.eyebrow} title={copy.projects.heading} copy={copy.projects.copy} />
    </div>

    {
      projects.length > 0 ? (
        <>
          <div class="mt-10 max-w-xl">
            <label for="project-title-search" class="mb-2 block font-mono text-xs uppercase tracking-[0.16em] text-mist">
              {copy.projects.searchLabel}
            </label>
            <div class="relative">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-mist/70">
                <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.7" />
                <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              </svg>
              <input
                id="project-title-search"
                type="search"
                data-project-search
                placeholder={copy.projects.searchPlaceholder}
                class="w-full rounded-xl border border-white/10 bg-white/[0.035] py-3 pl-11 pr-4 text-sm text-white placeholder:text-mist/60 transition-colors focus:border-cloud/40 focus:outline-none focus:ring-2 focus:ring-cloud/20"
              />
            </div>
          </div>
          <div class:list={["mt-5 grid gap-4", projects.length === 1 ? "max-w-4xl" : "md:grid-cols-2"]}>
          {projects.map((project) => (
            <a
              href={localizePath(`/projects/${project.data.pathSlug}/`, locale)}
              data-project-card
              data-project-title={project.data.title}
              class="group flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.025] p-5 transition-colors hover:border-cloud/30 hover:bg-white/[0.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cloud sm:p-6"
            >
              <h2 class="text-lg font-semibold leading-snug tracking-tight text-white transition-colors group-hover:text-cloud sm:text-xl">
                {project.data.title}
              </h2>
              <p class="mt-3 text-sm leading-6 text-mist">{project.data.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.data.technologies.slice(0, 4).map((technology) => (
                  <span class="tag-chip px-2 py-1 text-[0.68rem] normal-case tracking-normal">{technology}</span>
                ))}
                {project.data.technologies.length > 4 && (
                  <span class="tag-chip px-2 py-1 text-[0.68rem] normal-case tracking-normal">
                    +{project.data.technologies.length - 4}
                  </span>
                )}
              </div>
              <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-4">
                <span class="button-secondary min-h-0 w-fit px-4 py-2 text-xs normal-case tracking-normal sm:text-xs">
                  {copy.common.openProject}
                </span>
                <span class="inline-flex items-center gap-2 rounded-full border border-cloud/20 bg-cloud/[0.06] px-3 py-1.5 text-xs text-cloud/90">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-cloud/70">
                    <path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                  <span class="font-semibold tabular-nums text-white" data-project-view-count={project.data.translationKey}>—</span>
                  <span
                    data-project-view-word={project.data.translationKey}
                    data-singular={copy.projects.readSingular}
                    data-plural={copy.projects.readPlural}
                  >
                    {copy.projects.readPlural}
                  </span>
                </span>
              </div>
            </a>
          ))}
          </div>
          <p data-project-search-empty hidden class="copy-muted mt-5 rounded-2xl border border-line bg-panel p-6">
            {copy.projects.searchEmpty}
          </p>
        </>
      ) : (
        <p class="copy-muted mt-12 rounded-2xl border border-line bg-panel p-6">{copy.projects.empty}</p>
      )
    }
  </section>
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>("[data-project-search]");
  const projectCards = Array.from(document.querySelectorAll<HTMLElement>("[data-project-card]"));
  const noSearchResults = document.querySelector<HTMLElement>("[data-project-search-empty]");

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.trim().toLocaleLowerCase();
    let visibleProjects = 0;

    projectCards.forEach((card) => {
      const title = card.dataset.projectTitle?.toLocaleLowerCase() ?? "";
      const matches = title.includes(query);
      card.hidden = !matches;
      if (matches) visibleProjects += 1;
    });

    if (noSearchResults) noSearchResults.hidden = visibleProjects > 0;
  });
</script>
