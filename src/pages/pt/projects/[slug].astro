---
import { getCollection, render } from "astro:content";
import MermaidDiagrams from "../../../components/MermaidDiagrams.astro";
import PostLayout from "../../../layouts/PostLayout.astro";
import { findTranslatedEntry, getLocaleContent, getSectionPath } from "../../../lib/i18n";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.locale === "pt");

  return projects.map((project) => ({
    params: { slug: project.data.pathSlug },
    props: { project }
  }));
}

const copy = getLocaleContent("pt");
const allProjects = await getCollection("projects");
const { project } = Astro.props;
const translatedProject = findTranslatedEntry(allProjects, project.data.translationKey, "en");
const switchPath = translatedProject ? `/projects/${translatedProject.data.pathSlug}` : getSectionPath("projects", "en");
const { Content, headings } = await render(project);
---

<PostLayout
  title={project.data.title}
  description={project.data.description}
  locale="pt"
  switchPath={switchPath}
  tags={project.data.technologies}
  projectDetail
  headings={headings}
>
  {(project.data.github_link || project.data.demo_link) && (
    <div class="mb-8 grid gap-4 rounded-2xl border border-white/10 bg-white/3 p-6 text-sm text-mist sm:grid-cols-2">
      {project.data.github_link && (
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-cloud">{copy.common.github}</p>
          <a href={project.data.github_link} target="_blank" rel="noreferrer" aria-label={`${copy.projects.githubLinkLabel} (${project.data.github_link})`} class="mt-3 inline-flex items-center gap-2 rounded-xl border border-cloud/25 bg-cloud/[0.07] px-4 py-2.5 font-mono text-sm text-cloud transition-colors hover:border-cloud/50 hover:bg-cloud/12 hover:text-white focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-cloud">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path fill-rule="evenodd" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.31-3.76-1.31-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.63 1.2 3.27.91.1-.71.39-1.2.71-1.48-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.11-1.45 3.05-1.15 3.05-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.29-2.61 5.23-5.1 5.5.4.35.76 1.02.76 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" clip-rule="evenodd" />
            </svg>
            <span>{copy.projects.githubLinkLabel}</span>
          </a>
        </div>
      )}
      {project.data.demo_link && (
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-cloud">{copy.common.demo}</p>
          <a href={project.data.demo_link} target="_blank" rel="noreferrer" class="mt-2 inline-block text-white hover:text-cloud">
            {project.data.demo_link}
          </a>
        </div>
      )}
    </div>
  )}
  <span hidden data-project-view-page={project.data.translationKey}></span>
  <Content />
  <MermaidDiagrams />
</PostLayout>
